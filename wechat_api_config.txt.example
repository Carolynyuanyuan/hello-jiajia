# 微信 API 配置文件
#
# 使用方法：
# 1. 复制此文件为 wechat_api_config.txt:
#    cp wechat_api_config.txt.example wechat_api_config.txt
#
# 2. 填写你的 token 和 cookie
# 3. 保存后运行爬虫
#
# 注意：wechat_api_config.txt 已加入 .gitignore，不会被提交到 git

# 从浏览器 URL 中提取的 token（例如：token=759683668）
token=你的token

# 从浏览器开发者工具中复制的完整 Cookie 字符串
cookie=你的完整cookie字符串
